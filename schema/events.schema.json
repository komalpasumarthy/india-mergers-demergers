{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pasumarthykomal/india-mergers-demergers/schema/events.schema.json",
  "title": "Indian mergers and demergers",
  "description": "Structural rules only. Cross-field rules (cost sums, status) are enforced by scripts/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "dateOrNull": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "isin": {"type": "string", "pattern": "^IN[A-Z0-9]{9}[0-9]$"},
    "ratio": {"type": "string", "pattern": "^\\d+(\\.\\d+)?:\\d+(\\.\\d+)?$"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "step", "kind", "source_ticker", "source_isin", "source_name",
                   "source_aliases", "source_continues", "ex_date", "record_date",
                   "last_trading_date", "status", "terms_source", "notes", "legs"],
      "properties": {
        "scheme": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "step": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["MERGER", "DEMERGER"]},
        "source_ticker": {"type": "string", "minLength": 1},
        "source_isin": {"anyOf": [{"$ref": "#/$defs/isin"}, {"type": "null"}]},
        "source_name": {"type": "string", "minLength": 1},
        "source_aliases": {"$ref": "#/$defs/aliases"},
        "source_continues": {"type": "boolean"},
        "ex_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "record_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "last_trading_date": {"$ref": "#/$defs/dateOrNull"},
        "status": {"enum": ["complete", "detected"]},
        "terms_source": {"type": "string"},
        "notes": {"type": "string"},
        "legs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/leg"}}
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ticker", "target_isin", "target_name", "target_aliases", "instrument",
                   "ratio", "cost_share_pct", "listing_date", "face_value", "cash_per_share"],
      "properties": {
        "target_ticker": {"type": ["string", "null"]},
        "target_isin": {"anyOf": [{"$ref": "#/$defs/isin"}, {"type": "null"}]},
        "target_name": {"type": "string", "minLength": 1},
        "target_aliases": {"$ref": "#/$defs/aliases"},
        "instrument": {"enum": ["equity", "preference"]},
        "ratio": {"anyOf": [{"$ref": "#/$defs/ratio"}, {"type": "null"}]},
        "cost_share_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "listing_date": {"$ref": "#/$defs/dateOrNull"},
        "face_value": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "cash_per_share": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
